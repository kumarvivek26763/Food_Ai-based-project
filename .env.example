# --- MongoDB (required) ---
# Local: start `mongod` or MongoDB Windows service, then:
MONGODB_URI=mongodb://127.0.0.1:27017/ai_food_waste
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/ai_food_waste?retryWrites=true&w=majority

PORT=5000

# --- Flask ML service (required for real Random Forest predictions) ---
ML_SERVICE_URL=http://127.0.0.1:5001
# Optional: axios timeout to /predict (ms)
# ML_REQUEST_TIMEOUT_MS=8000

# When true, if Flask is down or ML_SERVICE_URL is unset, API uses a documentation baseline
# (food ≈ 1.1 × students) so the UI still works locally. Set false in production when ML must be used.
ALLOW_PREDICTION_FALLBACK=true

# Waste % at or above this value sets alert=true (default in code: 25 if unset)
ALERT_WASTE_THRESHOLD=25

# --- Optional: email when NGOs are notified (Map flow) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=app_password
# SMTP_FROM="Food Waste AI <you@example.com>"
# ALERT_EMAIL_TO=ngo-coordinator@example.com

# Google Maps: configure in client/.env — see client/.env.example (REACT_APP_GOOGLE_MAPS_API_KEY)
